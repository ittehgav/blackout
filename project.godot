locale/translations_pot_files=PackedStringArray("res://resources/dialogues/buildings/chop_shop.dialogue", "res://resources/dialogues/buildings/farmer.dialogue", "res://resources/dialogues/buildings/gas_station.dialogue", "res://resources/dialogues/buildings/gym.dialogue", "res://resources/dialogues/buildings/tech_shop.dialogue", "res://resources/dialogues/buildings/hoarder.dialogue", "res://resources/dialogues/buildings/wandering_trader.dialogue", "res://resources/dialogues/buildings/factory_worker.dialogue", "res://resources/dialogues/buildings/laboratory.dialogue", "res://resources/dialogues/buildings/black_market.dialogue")

[layer_names]

2d_physics/layer_1="team_1"
2d_physics/layer_2="team_2"

[physics]

2d/default_gravity=0.0
2d/default_gravity_vector=Vector2(0, 0)

[rendering]

textures/canvas_textures/default_texture_filter=3
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=0
textures/light_projectors/filter=0
environment/defaults/default_clear_color=Color(0.4, 0.501961, 0.4, 1)
viewport/transparent_background=true
2d/snap/snap_2d_transforms_to_pixel=true
