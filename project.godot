; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

warnings/check_invalid_track_paths=false

[application]

config/name="Wewfr"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
boot_splash/bg_color=Color(0.2, 0.0392157, 0.0392157, 1)
boot_splash/image="uid://dsiggbga76o2k"
boot_splash/minimum_display_time=500

[autoload]

ColorCoder="*res://global/color_coder.gd"
Entities="*res://global/entities.gd"
Combat="*res://global/combat/combat.gd"
Index="*res://global/index/index.tscn"
Trade="*res://global/world_map/trade.gd"
Scaling="*res://global/combat/scaling.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
Statuses="*res://global/combat/statuses.gd"
SaveSystem="*res://global/save_system/save_system.gd"
LoadSystem="*res://global/save_system/load_system.gd"
Dialogue="*res://global/dialogue.gd"
Tweens="*res://global/tweens.tscn"
Tutorial="*res://tutorials/tutorial_control.gd"

[debug]

gdscript/warnings/unassigned_variable=0
gdscript/warnings/unused_signal=0
gdscript/warnings/untyped_declaration=2
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
mouse_cursor/custom_image="uid://sjiy6rhhrwbb"
mouse_cursor/custom_image_hotspot=Vector2(32, 32)

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "red",
"res://global/": "orange",
"res://resources/": "green",
"res://scenes/": "yellow",
"res://scenes/index/": "blue"
}

[filesystem]

import/blender/enabled=false

[global_group]

all_settlements="Nodes that get saved"
aoe_projections="projections for AOE attacks that only appear when the unit is not on the player's team in battle"
all_locations="all buildings, for calling routines associates with the global clock"

[gui]

theme/default_font_generate_mipmaps=true
theme/custom="uid://b7n6onus7l7v3"
theme/custom_font="uid://sph0kotu777o"

