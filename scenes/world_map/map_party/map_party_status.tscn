[gd_scene load_steps=2 format=3 uid="uid://ysjmmqfgowae"]

[sub_resource type="GDScript" id="GDScript_24n7s"]
script/source = "extends Node

class_name MapPartyStatus;

@onready var party:MapParty = get_parent();
var current_statuses:Array[String];

var previous_speed:int;

func add_status(key:String)->void:
	## treat other more complex statuses when they come to be
	match key:
		\"slow\":
			if not \"slow\" in current_statuses:
				previous_speed = party.navigation_speed;
			party.navigation_speed /= 2
			party.refresh_speed();
			

func remove_status(key:String, all_occurences:bool=true)->void:
	assert(key in current_statuses);
	if all_occurences:
		match key:
			\"slow\":
				party.navigation_speed = previous_speed;
				while \"slow\" in current_statuses:
					current_statuses.erase(\"slow\");
"

[node name="map_party_status" type="Node"]
script = SubResource("GDScript_24n7s")
